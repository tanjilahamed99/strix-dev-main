# ===================================================
# StrixDevs Environment Configuration Template
# COPY TO .env.local AND FILL IN CREDENTIALS
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL
# ===================================================

# MongoDB Connection String (Required)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Admin Dashboard Authentication (Required)
ADMIN_PASSWORD=change-me-to-a-secure-admin-passcode
ADMIN_SESSION_SECRET=change-me-to-a-cryptographically-secure-random-string

# Email Notifications (Nodemailer via Gmail SMTP)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-gmail-app-password

# Public Site Configuration
NEXT_PUBLIC_SITE_URL=https://strixdevs.com
NEXT_PUBLIC_GOOGLE_MEET_URL=https://meet.google.com/strix-devs-meet

# Optional: Google Calendar Service Account (for automatic calendar event creation)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=primary

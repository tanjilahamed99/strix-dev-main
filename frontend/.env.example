# ==========================================
# Strix Devs - Environment Variables Example
# Copy this file to .env (or .env.local) and fill in your values
# ==========================================

# MongoDB Database Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=StrixDevs

# SMTP Email Configuration (for Nodemailer contact and consultation emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password

# Notification Receiver (Strix Devs Team Inbox)
CONTACT_RECEIVER_EMAIL=your-email@gmail.com

# Site URL and Consultation Meet Links
NEXT_PUBLIC_SITE_URL=https://strixdevs.com
NEXT_PUBLIC_GOOGLE_MEET_URL=https://meet.google.com/tuc-bauo-tgo

# Admin Dashboard Credentials
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_SESSION_SECRET=replace-with-a-random-32-character-secret-string

# Google Calendar OAuth (Optional / if utilizing Google Calendar auto-booking)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground
GOOGLE_REFRESH_TOKEN=
